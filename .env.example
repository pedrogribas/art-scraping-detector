# Copie este arquivo para `.env` e preencha com suas credenciais.
# O arquivo `.env` NÃO deve ser versionado (já está no .gitignore).

# ---------------------------------------------------------------------------
# Reddit (obrigatório para o módulo reddit_scraper)
# Crie um app do tipo "script" em: https://www.reddit.com/prefs/apps
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=seu_client_id_aqui
REDDIT_CLIENT_SECRET=seu_client_secret_aqui
REDDIT_USER_AGENT=python:art-scraping-detector:v1.0 (by /u/seu_usuario)

# ---------------------------------------------------------------------------
# Unsplash (opcional). Sem a chave, o web_scraper opera em modo HTML público.
# Registre um app em: https://unsplash.com/developers
# ---------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Parâmetros de coleta (opcionais: há valores padrão em src/scraper/config.py)
# ---------------------------------------------------------------------------
TARGET_IMAGE_COUNT=1500
MIN_REQUEST_DELAY=1.5
MAX_REQUEST_DELAY=4.0
REQUEST_TIMEOUT=20
MAX_RETRIES=3
LOG_LEVEL=INFO
