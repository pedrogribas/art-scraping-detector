# Copie este arquivo para `.env` e preencha conforme necessário.
# O arquivo `.env` NÃO deve ser versionado (já está no .gitignore).
#
# Das cinco fontes do pipeline, só o Pexels exige credencial. Museus
# (Met e Art Institute), Safebooru e os feeds RSS são abertos.

# ---------------------------------------------------------------------------
# Pexels (opcional). Sem a chave, a cota do módulo é redistribuída.
# Chave gratuita em: https://www.pexels.com/api/
# ---------------------------------------------------------------------------
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# Unsplash (opcional, módulo de reserva). Sem a chave, o web_scraper usa
# o Openverse, que é aberto. Registre um app em https://unsplash.com/developers
# ---------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Identificação nas APIs públicas. O servidor de imagens do Art Institute of
# Chicago responde HTTP 403 sem um contato válido neste header.
# ---------------------------------------------------------------------------
AIC_CONTACT=art-scraping-detector (seu.email@exemplo.com)

# ---------------------------------------------------------------------------
# Parâmetros de coleta (opcionais: há valores padrão em src/scraper/config.py)
# ---------------------------------------------------------------------------
TARGET_IMAGE_COUNT=5000
MIN_REQUEST_DELAY=1.5
MAX_REQUEST_DELAY=4.0
REQUEST_TIMEOUT=20
MAX_RETRIES=3
LOG_LEVEL=INFO

# Imagens do Met: 1 usa a versão web (~300 KB), 0 baixa o original (vários MB).
MET_PREFER_SMALL_IMAGE=1
# Largura solicitada ao servidor IIIF do Art Institute of Chicago.
AIC_IMAGE_WIDTH=843
# Tamanho retornado pela API do Pexels: original, large2x, large ou medium.
PEXELS_IMAGE_SIZE=large2x
