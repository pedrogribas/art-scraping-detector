*.pem
credentials.json

# ---------------------------------------------------------------------------
# Dataset (não versionado: volume alto e direitos autorais de terceiros).
# Apenas os marcadores .gitkeep preservam a estrutura de pastas no Git.
# ---------------------------------------------------------------------------
data/*
!data/raw/
!data/processed/
!data/adulterated/
data/raw/*
data/processed/*
data/adulterated/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/adulterated/.gitkeep

